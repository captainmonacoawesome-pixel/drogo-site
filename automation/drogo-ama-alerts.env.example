# Private on Ripper: sudo chmod 600 /etc/drogo-ama-alerts.env
# Generate with: openssl rand -hex 32
# Add the SAME value as Cloudflare Pages Production encrypted secret AMA_ALERT_READ_TOKEN
AMA_ALERT_READ_TOKEN=REPLACE_WITH_64_CHARACTER_HEX_SECRET
# Use the same ntfy.sh topic subscribed on your phone (keep private).
AMA_NTFY_URL=https://ntfy.sh/REPLACE_WITH_PRIVATE_TOPIC
