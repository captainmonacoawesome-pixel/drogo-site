[Unit]
Description=Drogo AMA notification poller (Ripper)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=drogo-ama-alerts
Environment=AMA_ALERT_STATE_DIR=/var/lib/drogo-ama-alerts
EnvironmentFile=/etc/drogo-ama-alerts.env
ExecStart=/usr/bin/python3 /opt/drogo-ama-alerts/ama_alert_poller.py
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
