[Unit]
Description=The Weekly Mush publishing engine
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=weekly-mush
Environment=MUSH_STATE_DIR=/var/lib/weekly-mush
EnvironmentFile=/etc/weekly-mush.env
ExecStart=/usr/bin/python3 /opt/weekly-mush/weekly_mush.py --send
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
